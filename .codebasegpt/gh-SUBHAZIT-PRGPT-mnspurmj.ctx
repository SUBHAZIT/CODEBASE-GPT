    'gemini-2.0-flash', 'gemini-2.5-pro', '0.7', '3', '120000', '6', '6', 'en-US');
    const geminiOptions = new GeminiOptions(options.geminiHeavyModel, new TokenLimits(options.geminiHeavyModel));
